      "shape": {
        "xs": 6,
        "sm": 10,
        "md": 14,
        "lg": 18,
        "xl": 24,
        "full": 999
      },
      "fonts": {
        "ui": "IBM Plex Sans",
        "display": "IBM Plex Sans",
        "label": "IBM Plex Sans",
        "mono": "IBM Plex Mono"
